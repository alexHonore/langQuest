{
  "name": "@langquest/scripts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LangQuest data/ops CLIs: corpus importers, bulk audio scan, license report, catalog seed, curriculum seed, coverage validation, content factory.",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src",
    "import-tatoeba": "tsx src/import-tatoeba.ts",
    "import-taskmaster": "tsx src/import-taskmaster.ts",
    "import-corpora": "tsx src/import-corpora.ts",
    "bulk-audio-scan": "tsx src/bulk-audio-scan.ts",
    "license-report": "tsx src/license-report.ts",
    "seed-languages": "tsx src/seed-languages.ts",
    "seed-curriculum": "tsx src/seed-curriculum.ts",
    "validate-course-coverage": "tsx src/validate-course-coverage.ts",
    "content-factory": "tsx src/content-factory.ts",
    "export-flutter-content": "tsx src/export-flutter-content.ts",
    "attach-tatoeba-examples": "tsx src/attach-tatoeba-examples.ts",
    "synthesize-bundle-audio": "NODE_USE_ENV_PROXY=1 tsx src/synthesize-bundle-audio.ts",
    "publish-content": "NODE_USE_ENV_PROXY=1 tsx src/publish-content.ts",
