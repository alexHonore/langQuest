# ---- Supabase (Auth + Postgres) ----
SUPABASE_URL=                      # https://<ref>.supabase.co
SUPABASE_ANON_KEY=                 # publishable/anon key (safe for clients)
SUPABASE_SERVICE_ROLE_KEY=         # SERVER ONLY. never ship to mobile/admin browser bundles
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=             # management API token for CLI/migrations (local dev only)
SUPABASE_JWT_SECRET=               # legacy HS256 secret (only if project uses legacy JWT signing)

# ---- Cloudflare (R2 + Workers + Queues) ----
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=              # scoped token for wrangler (preferred over global key)
CLOUDFLARE_EMAIL=                  # only with a Global API key
CLOUDFLARE_API_KEY=                # Global API key (avoid in CI; use scoped token)
R2_BUCKET=langquest-media
R2_PUBLIC_BUCKET=langquest-public
R2_ACCESS_KEY_ID=                  # R2 S3 API token (server only)
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=                       # https://<account>.r2.cloudflarestorage.com

# ---- AI providers ----
OPENROUTER_API_KEY=                # server only
OPENROUTER_SITE_URL=https://langquest.app   # reserved (HTTP-Referer attribution); not read by code yet
OPENROUTER_APP_NAME=LangQuest               # reserved; not read by code yet
AZURE_SPEECH_KEY=                  # optional: pronunciation assessment adapter
AZURE_SPEECH_REGION=
REALTIME_VOICE_PROVIDER=pipeline   # reserved: pipeline is the only implemented provider (ADR-002)
GEMINI_API_KEY=                    # unused by LangQuest (kept out of the app)

# ---- Email / notifications ----
RESEND_API_KEY=                    # optional: operator alerts / Supabase SMTP (not wired yet)
RESEND_FROM=LangQuest <noreply@alexhonore.com>

# ---- App URLs ----
API_BASE_URL=http://localhost:8787      # documentation only; apps read the *_PUBLIC_* variants below
ADMIN_BASE_URL=http://localhost:3000    # documentation only
EXPO_PUBLIC_API_BASE_URL=http://localhost:8787
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787

# ---- Jobs / queues ----
JOBS_BACKEND=postgres              # postgres (free, polling) | cloudflare_queues (Workers Paid)
JOBS_POLL_INTERVAL_MS=2000             # runner default (apps/jobs)
FFMPEG_PATH=ffmpeg

# ---- Observability ----
SENTRY_DSN=                        # optional; adapter not wired yet (telemetry sinks: console, Supabase)
POSTHOG_API_KEY=                   # optional; PostHogSink is a no-op without it
POSTHOG_HOST=https://us.i.posthog.com
