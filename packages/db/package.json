{
  "name": "@langquest/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src",
    "local:start": "supabase start -x realtime,storage-api,imgproxy,edge-runtime,logflare,vector,supavisor",
    "local:stop": "supabase stop",
    "local:reset": "supabase db reset",
    "gen-types": "infra-tayoo db types --schema public --out src/database.types.ts && prettier --write src/database.types.ts",
    "gen-types:local": "supabase gen types typescript --local --schema public > src/database.types.ts",
    "migrate": "infra-tayoo db push",
    "seed": "tsx src/seed/run-seed.ts",
    "seed:catalog-sql": "tsx src/seed/write-catalog-sql.ts",
    "seed:characters-sql": "tsx src/seed/write-characters-sql.ts"
  },
  "dependencies": {
    "zod": "^4.6.0",
    "@supabase/supabase-js": "^2.117.0",
    "postgres": "^3.4.9",
    "dotenv": "^18.0.0",
    "@langquest/contracts": "workspace:*"
  },
  "devDependencies": {
    "supabase": "^2.121.0",
    "tsx": "^4.23.0",
    "vitest": "^4.1.0",
    "@langquest/ui": "workspace:*"
  }
}
