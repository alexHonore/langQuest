{
  "name": "langquest",
  "private": true,
  "version": "0.1.0",
  "description": "LangQuest \u2014 conversation-first, AI-native language learning (free for every learner).",
  "packageManager": "pnpm@10.26.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:api": "pnpm --filter @langquest/api dev",
    "dev:admin": "pnpm --filter @langquest/admin dev",
    "dev:mobile": "pnpm --filter @langquest/mobile start",
    "dev:jobs": "pnpm --filter @langquest/jobs dev",
    "db:migrate": "pnpm --filter @langquest/db migrate",
    "db:seed": "pnpm --filter @langquest/db seed",
    "db:types": "pnpm --filter @langquest/db gen-types",
    "validate:coverage": "pnpm --filter @langquest/scripts validate-course-coverage"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "eslint": "^9.39.0",
    "prettier": "^3.9.0",
    "tsx": "^4.23.0",
    "turbo": "^2.11.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.40.0",
    "vitest": "^4.1.0",
    "supabase": "^2.121.0",
    "dotenv": "^18.0.0"
  }
}
