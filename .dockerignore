# The root Dockerfile builds only the Flutter web app: nothing else of the monorepo is sent to the builder.
*
!apps/mobile_flutter
apps/mobile_flutter/build
apps/mobile_flutter/.dart_tool
apps/mobile_flutter/.flutter-plugins*
apps/mobile_flutter/android/.gradle
apps/mobile_flutter/ios/Pods
apps/mobile_flutter/ios/.symlinks
**/.env*
