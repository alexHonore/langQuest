# Serves the Flutter web build (see the repository's root Dockerfile). TLS is terminated by the host in front.
{
	admin off
	auto_https off
	persist_config off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip
	header {
		# File names are not content-hashed: revalidate every time (unchanged files come back as 304).
		Cache-Control "no-cache"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	# The account backend's client-safe settings (deploy/config.json), filled from this container's environment on each
	# request: LQ_SUPABASE_URL / LQ_SUPABASE_ANON_KEY (else the hosted app's NEXT_PUBLIC_SUPABASE_*) and LQ_API_BASE_URL.
	# Empty values keep the app offline-only. Nothing is written at start-up (the platform may run a read-only image).
	templates /config.json {
		mime application/json
	}
	# The app routes with URL fragments (/#/path), so there is no index.html fallback: a missing file is a 404.
	file_server
}
