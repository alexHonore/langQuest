# Serves the Flutter web build (see the repository's root Dockerfile). TLS is terminated by the host in front.
{
	admin off
	auto_https off
	persist_config off
}

:{$PORT:3000} {
	root * /srv
	encode zstd gzip
	header {
		# File names are not content-hashed: revalidate every time (unchanged files come back as 304).
		Cache-Control "no-cache"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	# The app routes with URL fragments (/#/path), so there is no index.html fallback: a missing file is a 404.
	file_server
}
